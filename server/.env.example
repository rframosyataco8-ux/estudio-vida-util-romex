# === Base de datos ===
# SQL Server (local / SSMS Express)
DB_TYPE=mssql
MSSQL_SERVER=localhost
MSSQL_DATABASE=RomexQC
MSSQL_USER=sa
MSSQL_PASSWORD=TuPassword
MSSQL_ENCRYPT=false

# PostgreSQL (Render / cloud) — descomenta y comenta lo de arriba
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:pass@host:5432/romexqc

# === Servidor ===
PORT=3000
NODE_ENV=development

# Orígenes CORS permitidos (separados por coma). Vacío = permitir todos (solo dev)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
