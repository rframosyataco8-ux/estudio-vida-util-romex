# === Local (SQL Server) ===
DB_TYPE=mssql
MSSQL_SERVER=localhost
MSSQL_DATABASE=RomexQC
MSSQL_USER=sa
MSSQL_PASSWORD=TuPassword
MSSQL_ENCRYPT=false

# === Producción Render (PostgreSQL) ===
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:pass@host:5432/romexqc
# NODE_ENV=production

PORT=3000
NODE_ENV=development

# CORS (producción: tu dominio Render, separados por coma)
# CORS_ORIGINS=https://romex-qc.onrender.com

# === Reset de contraseña admin (UNA SOLA VEZ) ===
# Pon esto en Render → Environment, redeploy, entra con admin + la clave,
# luego BORRA esta variable y vuelve a desplegar.
# RESET_ADMIN_PASS=admin123
